  "creator": "srosca93",
  "title": "Sasha Callum thumbs",
  "notes": "Factory envelope + Callum-style thumbs. No hold-tap / home-row mods.\nThumbs always mean the same thing (not remapped per layer).\n1 Cursor, 2 ModsL, 3 ModsR, 4 Space.\nModsL+ModsR => Symbol, Cursor+ModsR => Number (conditional layers).\nMagic copied from factory; Factory-test &to 3 on RH C6R6 removed.",
  "tags": [
    "qwerty",
    "callum",
    "no-hrm",
    "programming",
    "vim"
  ],
  "custom_defined_behaviors": "conditional_layers {\n    compatible = \"zmk,conditional-layers\";\n    symbol {\n        if-layers = <LAYER_ModsL LAYER_ModsR>;\n        then-layer = <LAYER_Symbol>;\n    };\n    number {\n        if-layers = <LAYER_Cursor LAYER_ModsR>;\n        then-layer = <LAYER_Number>;\n    };\n};\n",
  "custom_devicetree": "",
